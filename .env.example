# Postgres connection string (Neon, or any Postgres provider)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/admin"

# Web Push (generate with `npx web-push generate-vapid-keys` — no account needed)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="xxxxx"
VAPID_PRIVATE_KEY="xxxxx"
VAPID_SUBJECT="mailto:you@example.com"

# Twilio (https://www.twilio.com — buy a phone number, needed for SMS/calling)
TWILIO_ACCOUNT_SID="ACxxxxx"
TWILIO_AUTH_TOKEN="xxxxx"
TWILIO_PHONE_NUMBER="+15555555555"

# Resend (https://resend.com — free tier, used for lead-notification emails)
RESEND_API_KEY="re_xxxxx"
NOTIFICATION_FROM_EMAIL="onboarding@resend.dev"
OWNER_NOTIFICATION_EMAIL="you@example.com"

# Shared secret the idle-followup cron sends as `Authorization: Bearer <value>`.
# Set the same value in Vercel's cron/env config; without it the endpoint is open.
CRON_SECRET="xxxxx"
